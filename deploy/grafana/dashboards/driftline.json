{
 "uid": "driftline",
 "title": "driftline \u2014 serving & drift",
 "schemaVersion": 39,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Predictions / s by model",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (role, version) (rate(driftline_predictions_total[1m]))",
     "legendFormat": "{{role}} v{{version}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Request latency p50 / p99",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(driftline_request_latency_seconds_bucket{endpoint=\"predict\"}[1m])))",
     "legendFormat": "__auto"
    },
    {
     "refId": "A",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(driftline_request_latency_seconds_bucket{endpoint=\"predict\"}[1m])))",
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Feature PSI vs training reference (alert > 0.2)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "driftline_feature_psi",
     "legendFormat": "{{feature}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Live MAE (minutes) from feedback",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "driftline_live_mae_minutes",
     "legendFormat": "{{role}} v{{version}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Shadow |champion - challenger| p90 (min)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.9, sum by (le) (rate(driftline_shadow_abs_diff_minutes_bucket[5m])))",
     "legendFormat": "p90"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Online feature store misses / s",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (feature) (rate(driftline_feature_store_miss_total[5m]))",
     "legendFormat": "{{feature}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "stat",
   "title": "Retrain alert",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "driftline_drift_alert",
     "legendFormat": "alert"
    }
   ]
  },
  {
   "id": 8,
   "type": "table",
   "title": "Loaded models",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 6,
    "y": 24,
    "w": 18,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "driftline_model_info",
     "legendFormat": "{{role}} v{{version}}"
    }
   ]
  }
 ]
}